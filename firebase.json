{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "test"
      ]
    }
  ],
  "hosting": {
    "public": ".",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/.*/**",
      "**/node_modules/**",
      "functions",
      "functions/**",
      "publicar.js",
      "CNAME",
      "README.md",
      "*.zip",
      "*.log"
    ],
    "rewrites": [
      { "source": "**", "destination": "/index.html" }
    ]
  }
}
