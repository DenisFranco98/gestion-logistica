{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "test"
      ]
    }
  ],
  "hosting": {
    "public": ".",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/.*/**",
      "**/node_modules/**",
      "functions",
      "functions/**",
      "publicar.js",
      "CNAME",
      "README.md",
      "*.zip",
      "*.log"
    ],
    "rewrites": [
      {
        "source": "/control-financiero/**",
        "destination": "/control-financiero.html"
      },
      {
        "source": "/gestiones-diarias/**",
        "destination": "/gestiones-diarias.html"
      },
      {
        "source": "/gestion-logistica/**",
        "destination": "/gestion-logistica.html"
      },
      {
        "source": "/integraciones",
        "destination": "/integraciones.html"
      },
      {
        "source": "/integraciones/**",
        "destination": "/integraciones.html"
      },
      {
        "source": "/admin/**",
        "destination": "/index.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
