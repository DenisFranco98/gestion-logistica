// ESTE ARCHIVO NO SE PEGA EN LA CONSOLA — es la versión comentada, para leer y
// entender por qué cada regla es como es. El editor de reglas de Firebase se
// atraganta con estos comentarios ("missing ; before statement", probado el
// 2026-08-17).
//
// PARA PEGAR usá el de al lado, que es JSON estricto y sin comentarios:
//     functions/reglas-firebase.pegar.json
//
// Al tocar ESTE archivo hay que regenerar el otro, o quedan distintos:
//     node functions/limpiar-reglas.js \
//          functions/reglas-firebase.json functions/reglas-firebase.pegar.json
//
// QUÉ CAMBIA respecto de las reglas actuales
// ------------------------------------------
// Hoy la raíz dice .read/.write "auth != null": cualquier cuenta logueada puede
// leer y escribir TODA la base. En Firebase, una regla de arriba que concede NO
// se puede restringir más abajo —las reglas hijas solo suman permisos, nunca los
// quitan—, así que para proteger un solo nodo hay que bajar ese permiso a cada
// nodo por separado.
//
// QUÉ NODOS ESTÁN CERRADOS (al 2026-08-18) — los otros 19 siguen abiertos:
//
//   bot_workspaces      lectura solo por consulta filtrada por empresa propia;
//                       escritura validando el empresaId contra admin_empresas
//   ventas_bot          las crea solo la Cloud Function; borrar, solo el dueño
//   ventas_bot_idx      ídem
//   carritos_bot        ídem — los carritos del bot, clave telefono_idCarrito
//   carritos_bot_idx    ídem, y además dice en qué mes vive cada carrito
//   config              superAdminUid solo lo reescribe el super admin actual
//   users               escritura: tu propio nodo, un admin, o el super admin
//   admins              ídem (el auto-registro de clientes sigue funcionando)
//   session_hist        por uid: lo tuyo, y los admins todo
//   session_reports     ídem
//   control_financiero  por tienda (user_tiendas o admin_empresas)
//   reportes            ídem
//   reportes_img        ídem
//   logistica_live      ídem
//
// ORDEN DE PUBLICACIÓN: primero el código, después estas reglas. Ya se hizo así
// (commits c09b138 y 3438058, publicados). Al revés, el código viejo choca:
// _migracionInicial escribía en /admins en cada carga y _botwCargar leía
// bot_workspaces entero — las dos cosas darían permission_denied.
//
// OJO: al sacar el permiso de la raíz, un nodo NUEVO que no esté listado acá
// queda bloqueado. Si más adelante se agrega algo que escriba en un nodo nuevo,
// hay que sumarlo a esta lista o va a fallar con permission_denied.
//
// ESTO TODAVÍA NO ES UN BLINDAJE DE LA BASE. Los 25 nodos de abajo siguen
// abiertos a cualquier cuenta logueada: un asesor puede leer y escribir el
// control financiero, los pedidos y los anticipos de otras tiendas. Cerrarlos es
// un trabajo aparte, nodo por nodo. Y en cada uno hay que revisar primero si la
// app lee el nodo entero y filtra en el cliente —como hacía el panel del bot—,
// porque ahí el cierre parece funcionar y no funciona.
{
  "rules": {

    // ── BOT DE VENTAS ────────────────────────────────────────────────────
    // Acá vive la API key de cada tienda: quien la lea puede registrar ventas
    // falsas en esa tienda. Es el único nodo secreto de la app — un asesor no
    // debe verlo ni el de su propia tienda.
    //
    // Acotado POR EMPRESA el 2026-08-17. Antes decía "cualquier admin", y como
    // el alta de admins es pública (el modal "¿Eres administrador? Crear cuenta"
    // es el alta de clientes del SaaS, y así se queda), cualquiera podía
    // registrarse y leer las API keys de TODAS las tiendas — con una key ajena se
    // inyectan ventas falsas en esa tienda.
    //
    // La lectura solo se concede a una CONSULTA FILTRADA por una empresa propia.
    // Leer el nodo entero queda denegado a propósito: en Realtime Database un
    // permiso en el padre alcanza a todo el subárbol, así que mientras se pudiera
    // leer "bot_workspaces" de una sola vez no había forma de esconder las claves
    // ajenas. Por eso _botwCargar() hace una consulta por cada empresa del admin
    // en vez de una lectura sola — las dos cosas van juntas, cambiar una sin la
    // otra rompe el panel del bot.
    //
    // Las Cloud Functions leen esto con el Admin SDK y no pasan por estas reglas,
    // así que los endpoints del bot no se ven afectados.
    "bot_workspaces": {
      ".indexOn": "empresaId",
      ".read": "auth != null && query.orderByChild === 'empresaId' && root.child('admin_empresas').child(auth.uid).child(query.equalTo).exists()",
      "$code": {
        ".write": "auth != null && ((newData.exists() && root.child('admin_empresas').child(auth.uid).child(newData.child('empresaId').val()).exists()) || (data.exists() && root.child('admin_empresas').child(auth.uid).child(data.child('empresaId').val()).exists()) || root.child('config').child('superAdminUid').val() === auth.uid)"
      }
    },

    // Las ventas del bot. Las CREA solo la Cloud Function, que usa el Admin SDK
    // y no pasa por estas reglas: por eso .write es false a nivel de tienda y no
    // hay forma de inyectar ventas falsas desde el navegador.
    //
    // Lee cualquiera con acceso a esa tienda, con el mismo criterio que usa el
    // resto de la app: estar en user_tiendas o ser admin de la empresa.
    //
    // BORRAR es la única escritura permitida desde la app, y solo al DUEÑO de
    // esa tienda. El "!newData.exists()" es lo que lo hace seguro: autoriza a
    // eliminar, pero no a crear ni a modificar. Sin eso, abrir la escritura para
    // poder borrar habilitaría también inventar ventas o cambiarles el importe
    // desde la consola del navegador.
    "ventas_bot": {
      "$empresaId": {
        ".read": "auth != null && (root.child('user_tiendas').child(auth.uid).child($empresaId).exists() || root.child('admin_empresas').child(auth.uid).child($empresaId).exists())",
        ".write": false,
        "$mes": {
          "$ventaId": {
            ".write": "!newData.exists() && auth != null && root.child('users').child(auth.uid).child('rol').val() === 'dueno' && root.child('user_tiendas').child(auth.uid).child($empresaId).exists()"
          }
        }
      }
    },

    // Índice para responder "¿ya existe este pedido?" sin leer el mes entero.
    // Mismo criterio. Al borrar una venta hay que borrar TAMBIÉN su entrada acá,
    // o la consulta seguiría diciendo que el pedido existe y el bot no volvería
    // a mandarlo nunca.
    "ventas_bot_idx": {
      "$empresaId": {
        ".read": "auth != null && (root.child('user_tiendas').child(auth.uid).child($empresaId).exists() || root.child('admin_empresas').child(auth.uid).child($empresaId).exists())",
        ".write": false,
        "$ventaId": {
          ".write": "!newData.exists() && auth != null && root.child('users').child(auth.uid).child('rol').val() === 'dueno' && root.child('user_tiendas').child(auth.uid).child($empresaId).exists()"
        }
      }
    },


    // ── CARRITOS DEL BOT ─────────────────────────────────────────────────
    // Mismo criterio que ventas_bot: los CREA solo la Cloud Function, que usa el
    // Admin SDK y no pasa por estas reglas, así que .write es false a nivel de
    // tienda y no hay forma de inventar carritos desde el navegador.
    //
    // Lee cualquiera con acceso a esa tienda. La diferencia con ventas es que acá
    // la clave es telefono_idCarrito y no telefono_fecha, pero para las reglas da
    // igual: lo que se valida es de qué tienda cuelga.
    //
    // BORRAR es la única escritura permitida desde la app, y solo al DUEÑO. El
    // "!newData.exists()" es lo que lo hace seguro: autoriza a eliminar, pero no a
    // crear ni a modificar. Sin eso, abrir la escritura para poder borrar
    // habilitaría también inventar carritos o cambiarles el importe.
    "carritos_bot": {
      "$empresaId": {
        ".read": "auth != null && (root.child('user_tiendas').child(auth.uid).child($empresaId).exists() || root.child('admin_empresas').child(auth.uid).child($empresaId).exists())",
        ".write": false,
        "$mes": {
          "$carritoId": {
            ".write": "!newData.exists() && auth != null && root.child('users').child(auth.uid).child('rol').val() === 'dueno' && root.child('user_tiendas').child(auth.uid).child($empresaId).exists()"
          }
        }
      }
    },

    // Índice para responder "¿ya existe este carrito?" sin leer el mes entero, y
    // para saber en qué mes vive cada uno. Eso segundo importa más acá que en
    // ventas: como la clave NO lleva la fecha, un carrito creado en agosto y
    // recuperado en septiembre podría acabar duplicado en los dos meses. El índice
    // es lo que dice dónde está, así que al borrar un carrito hay que borrar
    // TAMBIÉN su entrada acá, o /carritosExiste seguiría diciendo que existe.
    "carritos_bot_idx": {
      "$empresaId": {
        ".read": "auth != null && (root.child('user_tiendas').child(auth.uid).child($empresaId).exists() || root.child('admin_empresas').child(auth.uid).child($empresaId).exists())",
        ".write": false,
        "$carritoId": {
          ".write": "!newData.exists() && auth != null && root.child('users').child(auth.uid).child('rol').val() === 'dueno' && root.child('user_tiendas').child(auth.uid).child($empresaId).exists()"
        }
      }
    },

    // ── EL RESTO ─────────────────────────────────────────────────────────
    // Los 28 nodos que ya existían, con el mismo permiso que tienen hoy. No se
    // cambia nada de cómo venían funcionando; están listados uno por uno solo
    // porque al sacar el permiso de la raíz hay que dárselo a cada uno.
    "historial_diario":   { ".read": "auth != null", ".write": "auth != null" },
    "evt_hist":           { ".read": "auth != null", ".write": "auth != null" },
    // session_hist y session_reports van indexados por UID —no por tienda—, así
    // que se pueden cerrar sin el problema de las claves viejas que tienen los
    // nodos por tienda: cada quien lo suyo, y los admins todo.
    //
    // Quién escribe: _registrarPresencia (2546) y el update de salida (2586) y
    // _fbGuardarInformeSesion (4130), siempre sobre el uid propio. Quién lee de
    // otros: _malCargarSesiones (7346) y _malVerInforme (7419), que son el modal
    // de asesor del Panel Admin, y _migrarCuentaVieja (1418), herramienta de
    // consola. Todo eso cae en la rama de admins.
    //
    // El ".read" va en $uid y no en el nodo: _malCargarSesiones consulta con
    // orderByChild('start') sobre session_hist/{uid}, y una consulta necesita el
    // permiso en el nodo que se consulta, que es justamente $uid.
    "session_hist": {
      "$uid": {
        ".read":  "auth != null && ($uid === auth.uid || root.child('admins').child(auth.uid).exists() || root.child('config').child('superAdminUid').val() === auth.uid)",
        ".write": "auth != null && ($uid === auth.uid || root.child('admins').child(auth.uid).exists() || root.child('config').child('superAdminUid').val() === auth.uid)"
      }
    },
    "session_reports": {
      "$uid": {
        ".read":  "auth != null && ($uid === auth.uid || root.child('admins').child(auth.uid).exists() || root.child('config').child('superAdminUid').val() === auth.uid)",
        ".write": "auth != null && ($uid === auth.uid || root.child('admins').child(auth.uid).exists() || root.child('config').child('superAdminUid').val() === auth.uid)"
      }
    },
    "user_fotos":         { ".read": "auth != null", ".write": "auth != null" },
    "empresa_asesores":   { ".read": "auth != null", ".write": "auth != null" },
    "gestiones_sync":     { ".read": "auth != null", ".write": "auth != null" },
    // /users — la escritura pasa de "cualquier cuenta logueada" a "tu propio
    // nodo, o un admin, o el super admin".
    //
    // El ".write" NO se puede poner en "users" a secas: _perfilGuardar() deja
    // que cualquier asesor edite su propio nombre (app-shared.js:2310), así que
    // una regla de solo-admins le rompería el perfil a todo el mundo. Por eso va
    // por $uid con "$uid === auth.uid": verificado que lgs_user guarda el uid de
    // Firebase Auth y no el correo (todas las llamadas a _entrarApp pasan uid),
    // así que users/{lgs_user} es users/{auth.uid} y la comparación se cumple.
    //
    // Las otras cinco vías de escritura son del panel admin —_admGuardarUsuario,
    // _admGuardarEdicion, _admEliminarUsuario, _mgaAgregarAsesor y _migUsuario—
    // y quedan cubiertas por la rama de admins.
    //
    // La LECTURA queda como está a propósito: media app lee /users entero para
    // resolver nombres (el panel de equipo, el consolidado, _leerRoles). Cerrarla
    // es otro trabajo; lo que se cierra acá es la escritura, que es por donde se
    // escalaban privilegios.
    "users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && ($uid === auth.uid || root.child('admins').child(auth.uid).exists() || root.child('config').child('superAdminUid').val() === auth.uid)"
      }
    },
    "gestiones_diarias":  { ".read": "auth != null", ".write": "auth != null" },
    "user_tiendas":       { ".read": "auth != null", ".write": "auth != null" },
    "logistica_guias":    { ".read": "auth != null", ".write": "auth != null" },
    // ── CUATRO NODOS POR TIENDA ──────────────────────────────────────────
    // Mismo criterio que ventas_bot: se entra si esa tienda es tuya (user_tiendas)
    // o si sos admin de ella (admin_empresas). Antes cualquier cuenta logueada
    // leía y escribía los de TODAS las tiendas — control_financiero incluido, que
    // es la plata.
    //
    // Se comprobó antes de cerrarlos que las claves de primer nivel son todas
    // empresaId de verdad (13, 10, 10 y 12 claves, cero con nombre de tienda). Eso
    // importa porque _gdTK() cae al slug del nombre cuando no hay empresaId, y esos
    // datos habrían quedado inaccesibles: el slug no está en ningún índice.
    //
    // Relacionado: _leerTienda() mira la clave vieja cuando la nueva no existe, y
    // esa lectura ahora da permission_denied. Lleva un catch para que no deje la
    // pantalla colgada — ver el comentario ahí.
    "logistica_live": {
      "$empresaId": {
        ".read":  "auth != null && (root.child('user_tiendas').child(auth.uid).child($empresaId).exists() || root.child('admin_empresas').child(auth.uid).child($empresaId).exists())",
        ".write": "auth != null && (root.child('user_tiendas').child(auth.uid).child($empresaId).exists() || root.child('admin_empresas').child(auth.uid).child($empresaId).exists())"
      }
    },
    // config/superAdminUid ES la definición de quién manda en todo el sistema:
    // el login compara el uid contra este valor para conceder el rol
    // (app-shared.js:2797 y 2890). Estaba con ".write": "auth != null", o sea
    // que CUALQUIER cuenta logueada podía escribir su propio uid acá desde la
    // consola del navegador y quedar como super admin. Era la escalada de
    // privilegios más corta de la base: un solo paso, sin pasar por /admins.
    //
    // Ahora solo el super admin actual puede reescribirlo. El resto de config
    // queda EXACTAMENTE como estaba —no se toca lo que no hace falta tocar—;
    // hoy no hay ninguna otra clave en el código, pero si la base tiene alguna
    // de antes, sigue funcionando igual.
    //
    // OJO — las dos formas en que esta regla puede dejar el nodo inaccesible:
    //  1. Si superAdminUid está VACÍO hoy, nadie puede designarlo desde la app
    //     (data.val() no coincide con nadie).
    //  2. _saQuitarSuperAdmin() lo borra, y después cae en el caso 1.
    // En ambos se arregla escribiendo el uid a mano en la consola de Firebase,
    // que usa el Admin SDK y no pasa por estas reglas. Se prefirió esto antes
    // que un "|| !data.exists()", que dejaría la puerta abierta a que el primero
    // que llegue se apropie del sistema si el nodo alguna vez queda vacío.
    "config": {
      ".read": "auth != null",
      "superAdminUid": { ".write": "auth != null && data.val() === auth.uid" },
      "$otraClave":    { ".write": "auth != null" }
    },
    "anticipos":          { ".read": "auth != null", ".write": "auth != null" },
    "empresas":           { ".read": "auth != null", ".write": "auth != null" },
    // /admins — mismo criterio que /users: cada quien su nodo, más admins y
    // super admin. Antes cualquier cuenta logueada podía escribir acá, o sea
    // agregarse a sí misma a /admins y con eso abrirse además bot_workspaces,
    // que se protege justamente con root.child('admins').child(auth.uid).
    //
    // OJO — "$uid === auth.uid" mantiene A PROPÓSITO el auto-registro: el modal
    // de registro (_registrarAdmin, app-shared.js:3298) es público, crea la
    // cuenta con createUserWithEmailAndPassword y acto seguido escribe
    // admins/{su propio uid}. O sea que hoy cualquiera que llegue al login puede
    // registrarse como admin de negocios. Eso NO se cambió acá porque es el flujo
    // de alta de clientes, no un bug: cerrarlo es una decisión de producto.
    // Lo que sí queda cerrado es escribir en el nodo de OTRO admin.
    "admins": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && ($uid === auth.uid || root.child('admins').child(auth.uid).exists() || root.child('config').child('superAdminUid').val() === auth.uid)"
      }
    },
    "admin_empresas":     { ".read": "auth != null", ".write": "auth != null" },
    "reportes": {
      "$empresaId": {
        ".read":  "auth != null && (root.child('user_tiendas').child(auth.uid).child($empresaId).exists() || root.child('admin_empresas').child(auth.uid).child($empresaId).exists())",
        ".write": "auth != null && (root.child('user_tiendas').child(auth.uid).child($empresaId).exists() || root.child('admin_empresas').child(auth.uid).child($empresaId).exists())"
      }
    },
    // Las capturas viven aparte de los reportes a propósito: metidas dentro, leer
    // el mes entero arrastraría todas las imágenes aunque no se muestren. Mismo
    // permiso que el nodo del que cuelgan.
    "reportes_img": {
      "$empresaId": {
        ".read":  "auth != null && (root.child('user_tiendas').child(auth.uid).child($empresaId).exists() || root.child('admin_empresas').child(auth.uid).child($empresaId).exists())",
        ".write": "auth != null && (root.child('user_tiendas').child(auth.uid).child($empresaId).exists() || root.child('admin_empresas').child(auth.uid).child($empresaId).exists())"
      }
    },
    "login_audit":        { ".read": "auth != null", ".write": "auth != null" },
    "novedades":          { ".read": "auth != null", ".write": "auth != null" },
    "nov_img":            { ".read": "auth != null", ".write": "auth != null" },
    "presence":           { ".read": "auth != null", ".write": "auth != null" },
    // La plata de cada tienda: control_financiero/{empresaId}/{mes} y /config
    // (ver _cfBase en control-financiero.js). Hasta ahora cualquier asesora de
    // cualquier tienda podía leer y escribir las finanzas de todas las demás.
    // El módulo entra siempre por ruta directa, sin el fallback de _leerTienda.
    "control_financiero": {
      "$empresaId": {
        ".read":  "auth != null && (root.child('user_tiendas').child(auth.uid).child($empresaId).exists() || root.child('admin_empresas').child(auth.uid).child($empresaId).exists())",
        ".write": "auth != null && (root.child('user_tiendas').child(auth.uid).child($empresaId).exists() || root.child('admin_empresas').child(auth.uid).child($empresaId).exists())"
      }
    },
    "catalogo_productos": { ".read": "auth != null", ".write": "auth != null" },
    "notes":              { ".read": "auth != null", ".write": "auth != null" },
    "ro":                 { ".read": "auth != null", ".write": "auth != null" },
    "rechazados_hist":    { ".read": "auth != null", ".write": "auth != null" }
  }
}
