// ARCHIVO COMPLETO DE REGLAS. Se pega tal cual, reemplazando todo lo que haya
// hoy en: Consola de Firebase -> Realtime Database -> Reglas -> Publicar.
//
// QUÉ CAMBIA respecto de las reglas actuales
// ------------------------------------------
// Hoy la raíz dice .read/.write "auth != null": cualquier cuenta logueada puede
// leer y escribir TODA la base. En Firebase, una regla de arriba que concede NO
// se puede restringir más abajo —las reglas hijas solo suman permisos, nunca los
// quitan—, así que para proteger un solo nodo hay que bajar ese permiso a cada
// nodo por separado.
//
// Eso es todo lo que hace este archivo: los 28 nodos que ya existían quedan
// EXACTAMENTE igual que hoy ("auth != null"), y solo cambian los tres del bot de
// ventas.
//
// OJO: al sacar el permiso de la raíz, un nodo NUEVO que no esté listado acá
// queda bloqueado. Si más adelante se agrega algo que escriba en un nodo nuevo,
// hay que sumarlo a esta lista o va a fallar con permission_denied.
//
// ESTO NO ES UN BLINDAJE DE LA BASE. Los 28 nodos siguen abiertos a cualquier
// cuenta logueada: un asesor puede leer y escribir los datos de otras tiendas, y
// /users y /admins siguen accesibles. Es solo el primer paso, el que cierra lo
// del bot. Cerrar el resto es un trabajo aparte, nodo por nodo, verificando que
// cada módulo siga funcionando.
{
  "rules": {

    // ── BOT DE VENTAS ────────────────────────────────────────────────────
    // Acá vive la API key de cada tienda: quien la lea puede registrar ventas
    // falsas en esa tienda. Es el único nodo secreto de la app, por eso lo ven
    // solo los admins — un asesor no debe verlo ni el de su propia tienda.
    // Las Cloud Functions lo leen con el Admin SDK, que se saltea estas reglas.
    "bot_workspaces": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
    },

    // Las ventas del bot. Las CREA solo la Cloud Function, que usa el Admin SDK
    // y no pasa por estas reglas: por eso .write es false a nivel de tienda y no
    // hay forma de inyectar ventas falsas desde el navegador.
    //
    // Lee cualquiera con acceso a esa tienda, con el mismo criterio que usa el
    // resto de la app: estar en user_tiendas o ser admin de la empresa.
    //
    // BORRAR es la única escritura permitida desde la app, y solo al DUEÑO de
    // esa tienda. El "!newData.exists()" es lo que lo hace seguro: autoriza a
    // eliminar, pero no a crear ni a modificar. Sin eso, abrir la escritura para
    // poder borrar habilitaría también inventar ventas o cambiarles el importe
    // desde la consola del navegador.
    "ventas_bot": {
      "$empresaId": {
        ".read": "auth != null && (root.child('user_tiendas').child(auth.uid).child($empresaId).exists() || root.child('admin_empresas').child(auth.uid).child($empresaId).exists())",
        ".write": false,
        "$mes": {
          "$ventaId": {
            ".write": "!newData.exists() && auth != null && root.child('users').child(auth.uid).child('rol').val() === 'dueno' && root.child('user_tiendas').child(auth.uid).child($empresaId).exists()"
          }
        }
      }
    },

    // Índice para responder "¿ya existe este pedido?" sin leer el mes entero.
    // Mismo criterio. Al borrar una venta hay que borrar TAMBIÉN su entrada acá,
    // o la consulta seguiría diciendo que el pedido existe y el bot no volvería
    // a mandarlo nunca.
    "ventas_bot_idx": {
      "$empresaId": {
        ".read": "auth != null && (root.child('user_tiendas').child(auth.uid).child($empresaId).exists() || root.child('admin_empresas').child(auth.uid).child($empresaId).exists())",
        ".write": false,
        "$ventaId": {
          ".write": "!newData.exists() && auth != null && root.child('users').child(auth.uid).child('rol').val() === 'dueno' && root.child('user_tiendas').child(auth.uid).child($empresaId).exists()"
        }
      }
    },


    // ── EL RESTO ─────────────────────────────────────────────────────────
    // Los 28 nodos que ya existían, con el mismo permiso que tienen hoy. No se
    // cambia nada de cómo venían funcionando; están listados uno por uno solo
    // porque al sacar el permiso de la raíz hay que dárselo a cada uno.
    "historial_diario":   { ".read": "auth != null", ".write": "auth != null" },
    "evt_hist":           { ".read": "auth != null", ".write": "auth != null" },
    "session_hist":       { ".read": "auth != null", ".write": "auth != null" },
    "session_reports":    { ".read": "auth != null", ".write": "auth != null" },
    "user_fotos":         { ".read": "auth != null", ".write": "auth != null" },
    "empresa_asesores":   { ".read": "auth != null", ".write": "auth != null" },
    "gestiones_sync":     { ".read": "auth != null", ".write": "auth != null" },
    // /users — la escritura pasa de "cualquier cuenta logueada" a "tu propio
    // nodo, o un admin, o el super admin".
    //
    // El ".write" NO se puede poner en "users" a secas: _perfilGuardar() deja
    // que cualquier asesor edite su propio nombre (app-shared.js:2310), así que
    // una regla de solo-admins le rompería el perfil a todo el mundo. Por eso va
    // por $uid con "$uid === auth.uid": verificado que lgs_user guarda el uid de
    // Firebase Auth y no el correo (todas las llamadas a _entrarApp pasan uid),
    // así que users/{lgs_user} es users/{auth.uid} y la comparación se cumple.
    //
    // Las otras cinco vías de escritura son del panel admin —_admGuardarUsuario,
    // _admGuardarEdicion, _admEliminarUsuario, _mgaAgregarAsesor y _migUsuario—
    // y quedan cubiertas por la rama de admins.
    //
    // La LECTURA queda como está a propósito: media app lee /users entero para
    // resolver nombres (el panel de equipo, el consolidado, _leerRoles). Cerrarla
    // es otro trabajo; lo que se cierra acá es la escritura, que es por donde se
    // escalaban privilegios.
    "users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && ($uid === auth.uid || root.child('admins').child(auth.uid).exists() || root.child('config').child('superAdminUid').val() === auth.uid)"
      }
    },
    "gestiones_diarias":  { ".read": "auth != null", ".write": "auth != null" },
    "user_tiendas":       { ".read": "auth != null", ".write": "auth != null" },
    "logistica_guias":    { ".read": "auth != null", ".write": "auth != null" },
    "logistica_live":     { ".read": "auth != null", ".write": "auth != null" },
    // config/superAdminUid ES la definición de quién manda en todo el sistema:
    // el login compara el uid contra este valor para conceder el rol
    // (app-shared.js:2797 y 2890). Estaba con ".write": "auth != null", o sea
    // que CUALQUIER cuenta logueada podía escribir su propio uid acá desde la
    // consola del navegador y quedar como super admin. Era la escalada de
    // privilegios más corta de la base: un solo paso, sin pasar por /admins.
    //
    // Ahora solo el super admin actual puede reescribirlo. El resto de config
    // queda EXACTAMENTE como estaba —no se toca lo que no hace falta tocar—;
    // hoy no hay ninguna otra clave en el código, pero si la base tiene alguna
    // de antes, sigue funcionando igual.
    //
    // OJO — las dos formas en que esta regla puede dejar el nodo inaccesible:
    //  1. Si superAdminUid está VACÍO hoy, nadie puede designarlo desde la app
    //     (data.val() no coincide con nadie).
    //  2. _saQuitarSuperAdmin() lo borra, y después cae en el caso 1.
    // En ambos se arregla escribiendo el uid a mano en la consola de Firebase,
    // que usa el Admin SDK y no pasa por estas reglas. Se prefirió esto antes
    // que un "|| !data.exists()", que dejaría la puerta abierta a que el primero
    // que llegue se apropie del sistema si el nodo alguna vez queda vacío.
    "config": {
      ".read": "auth != null",
      "superAdminUid": { ".write": "auth != null && data.val() === auth.uid" },
      "$otraClave":    { ".write": "auth != null" }
    },
    "anticipos":          { ".read": "auth != null", ".write": "auth != null" },
    "empresas":           { ".read": "auth != null", ".write": "auth != null" },
    // /admins — mismo criterio que /users: cada quien su nodo, más admins y
    // super admin. Antes cualquier cuenta logueada podía escribir acá, o sea
    // agregarse a sí misma a /admins y con eso abrirse además bot_workspaces,
    // que se protege justamente con root.child('admins').child(auth.uid).
    //
    // OJO — "$uid === auth.uid" mantiene A PROPÓSITO el auto-registro: el modal
    // de registro (_registrarAdmin, app-shared.js:3298) es público, crea la
    // cuenta con createUserWithEmailAndPassword y acto seguido escribe
    // admins/{su propio uid}. O sea que hoy cualquiera que llegue al login puede
    // registrarse como admin de negocios. Eso NO se cambió acá porque es el flujo
    // de alta de clientes, no un bug: cerrarlo es una decisión de producto.
    // Lo que sí queda cerrado es escribir en el nodo de OTRO admin.
    "admins": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && ($uid === auth.uid || root.child('admins').child(auth.uid).exists() || root.child('config').child('superAdminUid').val() === auth.uid)"
      }
    },
    "admin_empresas":     { ".read": "auth != null", ".write": "auth != null" },
    "reportes":           { ".read": "auth != null", ".write": "auth != null" },
    "reportes_img":       { ".read": "auth != null", ".write": "auth != null" },
    "login_audit":        { ".read": "auth != null", ".write": "auth != null" },
    "novedades":          { ".read": "auth != null", ".write": "auth != null" },
    "nov_img":            { ".read": "auth != null", ".write": "auth != null" },
    "presence":           { ".read": "auth != null", ".write": "auth != null" },
    "control_financiero": { ".read": "auth != null", ".write": "auth != null" },
    "catalogo_productos": { ".read": "auth != null", ".write": "auth != null" },
    "notes":              { ".read": "auth != null", ".write": "auth != null" },
    "ro":                 { ".read": "auth != null", ".write": "auth != null" },
    "rechazados_hist":    { ".read": "auth != null", ".write": "auth != null" }
  }
}
