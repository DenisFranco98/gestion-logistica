{
  "rules": {
    "bot_workspaces": {
      ".indexOn": "empresaId",
      ".read": "auth != null && query.orderByChild === 'empresaId' && root.child('admin_empresas').child(auth.uid).child(query.equalTo).exists()",
      "$code": {
        ".write": "auth != null && ((newData.exists() && root.child('admin_empresas').child(auth.uid).child(newData.child('empresaId').val()).exists()) || (data.exists() && root.child('admin_empresas').child(auth.uid).child(data.child('empresaId').val()).exists()) || root.child('config').child('superAdminUid').val() === auth.uid)"
      }
    },
    "ventas_bot": {
      "$empresaId": {
        ".read": "auth != null && (root.child('user_tiendas').child(auth.uid).child($empresaId).exists() || root.child('admin_empresas').child(auth.uid).child($empresaId).exists())",
        ".write": false,
        "$mes": {
          "$ventaId": {
            ".write": "!newData.exists() && auth != null && root.child('users').child(auth.uid).child('rol').val() === 'dueno' && root.child('user_tiendas').child(auth.uid).child($empresaId).exists()",
            "estado_orden": {
              ".write": "auth != null && data.parent().exists() && root.child('user_tiendas').child(auth.uid).child($empresaId).exists()"
            },
            "historial_estado": {
              ".write": "auth != null && data.parent().exists() && root.child('user_tiendas').child(auth.uid).child($empresaId).exists()"
            },
            "actualizado": {
              ".write": "auth != null && data.parent().exists() && root.child('user_tiendas').child(auth.uid).child($empresaId).exists()"
            }
          }
        }
      }
    },
    "ventas_bot_idx": {
      "$empresaId": {
        ".read": "auth != null && (root.child('user_tiendas').child(auth.uid).child($empresaId).exists() || root.child('admin_empresas').child(auth.uid).child($empresaId).exists())",
        ".write": false,
        "$ventaId": {
          ".write": "!newData.exists() && auth != null && root.child('users').child(auth.uid).child('rol').val() === 'dueno' && root.child('user_tiendas').child(auth.uid).child($empresaId).exists()",
          "estado": {
            ".write": "auth != null && data.parent().exists() && root.child('user_tiendas').child(auth.uid).child($empresaId).exists()"
          },
          "ts_actualizado": {
            ".write": "auth != null && data.parent().exists() && root.child('user_tiendas').child(auth.uid).child($empresaId).exists()"
          }
        }
      }
    },
    "carritos_bot": {
      "$empresaId": {
        ".read": "auth != null && (root.child('user_tiendas').child(auth.uid).child($empresaId).exists() || root.child('admin_empresas').child(auth.uid).child($empresaId).exists())",
        ".write": false,
        "$mes": {
          "$carritoId": {
            ".write": "!newData.exists() && auth != null && root.child('users').child(auth.uid).child('rol').val() === 'dueno' && root.child('user_tiendas').child(auth.uid).child($empresaId).exists()",
            "estado": {
              ".write": "auth != null && data.parent().exists() && root.child('user_tiendas').child(auth.uid).child($empresaId).exists()"
            },
            "historial_estado": {
              ".write": "auth != null && data.parent().exists() && root.child('user_tiendas').child(auth.uid).child($empresaId).exists()"
            },
            "actualizado": {
              ".write": "auth != null && data.parent().exists() && root.child('user_tiendas').child(auth.uid).child($empresaId).exists()"
            }
          }
        }
      }
    },
    "carritos_bot_idx": {
      "$empresaId": {
        ".read": "auth != null && (root.child('user_tiendas').child(auth.uid).child($empresaId).exists() || root.child('admin_empresas').child(auth.uid).child($empresaId).exists())",
        ".write": false,
        "$carritoId": {
          ".write": "!newData.exists() && auth != null && root.child('users').child(auth.uid).child('rol').val() === 'dueno' && root.child('user_tiendas').child(auth.uid).child($empresaId).exists()",
          "estado": {
            ".write": "auth != null && data.parent().exists() && root.child('user_tiendas').child(auth.uid).child($empresaId).exists()"
          },
          "ts_actualizado": {
            ".write": "auth != null && data.parent().exists() && root.child('user_tiendas').child(auth.uid).child($empresaId).exists()"
          }
        }
      }
    },
    "ads_bot": {
      "$empresaId": {
        ".read": "auth != null && (root.child('user_tiendas').child(auth.uid).child($empresaId).exists() || root.child('admin_empresas').child(auth.uid).child($empresaId).exists())",
        ".write": "auth != null && root.child('user_tiendas').child(auth.uid).child($empresaId).exists()",
        "$mes": {
          "$dia": {
            "$producto": {
              "v": {
                ".validate": "newData.isNumber() && newData.val() >= 0"
              },
              "p": {
                ".validate": "newData.isString() && newData.val().length <= 200"
              }
            }
          }
        }
      }
    },
    "dropi_oauth": {
      ".read": false,
      ".write": false
    },
    "historial_diario": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "evt_hist": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "session_hist": {
      "$uid": {
        ".read": "auth != null && ($uid === auth.uid || root.child('admins').child(auth.uid).exists() || root.child('config').child('superAdminUid').val() === auth.uid)",
        ".write": "auth != null && ($uid === auth.uid || root.child('admins').child(auth.uid).exists() || root.child('config').child('superAdminUid').val() === auth.uid)"
      }
    },
    "session_reports": {
      "$uid": {
        ".read": "auth != null && ($uid === auth.uid || root.child('admins').child(auth.uid).exists() || root.child('config').child('superAdminUid').val() === auth.uid)",
        ".write": "auth != null && ($uid === auth.uid || root.child('admins').child(auth.uid).exists() || root.child('config').child('superAdminUid').val() === auth.uid)"
      }
    },
    "user_fotos": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "empresa_asesores": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "gestiones_sync": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && ($uid === auth.uid || root.child('admins').child(auth.uid).exists() || root.child('config').child('superAdminUid').val() === auth.uid)"
      }
    },
    "gestiones_diarias": {
      ".read": "auth != null",
